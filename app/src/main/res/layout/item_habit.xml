<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="habit"
            type="com.example.habitapptracker.model.Habit" />
        <variable
            name="viewModel"
            type="com.example.habitapptracker.viewmodel.HabitViewModel" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:orientation="horizontal"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imgIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="14dp"
                android:layout_gravity="center_vertical"
                app:habitIcon="@{habit.icon}" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/txtName"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#1A1A1A"
                    android:text="@{habit.name}"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/txtDesc"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:text="@{habit.description}"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/txtProgress"
                    android:textSize="12sp"
                    android:textColor="#6A00F4"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:progressText="@{habit}" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:max="100"
                    android:progress="@{habit.goal == 0 ? 0 : (habit.currentProgress * 100 / habit.goal)}"
                    android:progressTint="#6A00F4"
                    android:progressBackgroundTint="#E0D9F7"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="6dp"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/txtStatus"
                        android:textSize="11sp"
                        android:textColor="#FFFFFF"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text='@{habit.currentProgress >= habit.goal ? "Completed" : "In Progress"}'
                        app:statusBackground="@{habit.currentProgress >= habit.goal}" />

                    <android.widget.Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:id="@+id/btnMinus"
                        android:text="−"
                        android:gravity="center"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#6A00F4"
                        android:background="@android:color/transparent"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:onClick="@{() -> viewModel.decrementProgress(habit)}" />

                    <TextView
                        android:id="@+id/btnPlus"
                        android:text="+"
                        android:gravity="center"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#6A00F4"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:onClick="@{() -> viewModel.incrementProgress(habit)}" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</layout>
